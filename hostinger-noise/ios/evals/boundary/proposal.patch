+    hit = ImageChops.multiply(a, b.filter(ImageFilter.MaxFilter(3))).histogram()[255] + \
+        ImageChops.multiply(b, a.filter(ImageFilter.MaxFilter(3))).histogram()[255]
+    return hit / (na + nb)
+
+
+def caption_same(jpeg, ref):
+    if Image is None or not ref:
+        return False
+    try:
+        return caption_overlap(jpeg, ref) >= LOCAL_SAME
+    except Exception:  # noqa: BLE001 - a bad JPEG goes to Jev
+        return False
