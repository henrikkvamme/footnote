+# The video boundary eval (evals/boundary/): Jev's "same" scores are at most 0.10 for another video and at least 0.17 for
+# the same one, so 0.15 sits in the gap. A missed cut costs a language model read (5 to 7 s); a scroll frame read as
+# "same" costs only 1 s, because the next frame shows the new video in full.
+SAME_T = float(os.environ.get("FOOTNOTE_SAME_T", "0.15"))
+LOCAL_SAME = 0.85  # caption overlap at or above: the same video with no model call (another video scored at most 0.71)
 
+try:  # Pillow is optional: without it every frame goes to Jev, as before.
+    from PIL import Image, ImageChops, ImageFilter
+except ImportError:
+    Image = None
 
+# The local caption check (evals/boundary/caption.py, the same code): the account and caption text of a 540 px TikTok
+# frame, white with a dark shadow, compared with the reference frame. 0.0 when the box holds almost no such text.
+CAPTION_BOX = (8, 925, 430, 1062)
+
+
+def _caption_mask(jpeg):
+    img = Image.open(io.BytesIO(jpeg)).convert("L")
+    if img.width != 540:
+        img = img.resize((540, round(img.height * 540 / img.width)))
+    g = img.crop(CAPTION_BOX)
+    white = g.point(lambda v: 255 if v > 215 else 0)
+    shadow = ImageChops.offset(g, -2, -2).point(lambda v: 255 if v < 170 else 0)
+    return ImageChops.multiply(white, shadow)
+
+
+def caption_overlap(jpeg, ref):
+    a, b = _caption_mask(jpeg), _caption_mask(ref)
+    na, nb = a.histogram()[255], b.histogram()[255]
+    if na + nb < 40:
+        return 0.0
